# Private source material for derived case imagery. These live outside public/
# on purpose: Vite copies everything in public/ into dist/, and img.png shows a
# login email, so keeping them there would publish them no matter what this
# file says.
/private-assets/

# Capture aids must never be servable from public/.
/public/__seed.html
/public/__og-card.html
